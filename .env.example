# ──────────────────────────────────────────────────────────────
# AestheticsLeads — environment variables
# ──────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_SITE_URL="https://theaestheticsatlas.com"
NEXT_PUBLIC_SITE_NAME="TheAestheticsAtlas"
NEXT_PUBLIC_DEFAULT_MARKET="quad-cities"

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aestheticsatlas?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/aestheticsatlas?schema=public"

# Auth
JWT_SECRET="change-me-to-a-32+char-random-string"
ADMIN_EMAIL="admin@theaestheticsatlas.com"
ADMIN_PASSWORD="change-me"

# Email (Resend)
RESEND_API_KEY=""
LEAD_NOTIFY_FROM="leads@theaestheticsatlas.com"

# AI content generation
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# Google Places (marketplace seeding) — restrict this key by API + referrer/IP.
GOOGLE_PLACES_API_KEY=""

# Analytics & tracking
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_POSTHOG_KEY=""

# Monetization
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
LEAD_PRICE_DEFAULT_CENTS="2500"
