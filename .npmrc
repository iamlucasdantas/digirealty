# pnpm config for this project.
# auto-install-peers: resolve peer deps without prompting (React/Next-friendly).
# strict-peer-dependencies=false: allow minor peer mismatches in dev.
auto-install-peers=true
strict-peer-dependencies=false

# These packages ship native binaries / postinstall scripts that MUST run
# for the app to work. Pnpm 9+ blocks build scripts by default for security,
# so we explicitly allow the ones we trust.
public-hoist-pattern[]=*prisma*
